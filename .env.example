# Copia este archivo a .env y complétalo. NUNCA subas .env al repositorio.
#
# Genera la clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base de datos. Por defecto SQLite en db.sqlite3.
# DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos

# Asistente (opcional). Sin esta clave el asistente queda desactivado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=20971520
